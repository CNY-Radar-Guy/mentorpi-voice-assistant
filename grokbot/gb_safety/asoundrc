# Grok Bot: share the WonderEcho USB mic between grokbot (voice), its barge-in stop listener and gb-clap.
pcm.gbsnoop {
    type dsnoop
    ipc_key 52817
    ipc_perm 0666
    slave {
        pcm "hw:CARD=Device,DEV=0"
        channels 2
        rate 48000
        format S16_LE
        period_size 960
        buffer_size 9600
    }
}
pcm.gbmic {
    type plug
    slave.pcm "gbsnoop"
}
