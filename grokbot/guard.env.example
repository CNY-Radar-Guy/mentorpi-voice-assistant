# Copy to guard.env on the Pi. guard.env is gitignored.
# Loaded by gb-guard.service (the LiDAR front-stop backup inside the container).
#
#   cp guard.env.example guard.env

# 0: the guard never stands down for a mission. gb_gate is the direction-aware guard.
GUARD_MISSION_BYPASS=0
# 0: stop only. Do not reverse or turn from this backup guard.
GUARD_TURN=0
# Metres from the LiDAR centre. The motion gate uses a wider fused corridor.
GUARD_STOP_DIST=0.220
GUARD_DRY_RUN=0
