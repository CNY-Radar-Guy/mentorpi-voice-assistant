# Copy to grokbot.env on the Pi and edit. grokbot.env is gitignored.
# Every value below is a placeholder or a safe default. None of these are real credentials.
#
#   cp grokbot.env.example grokbot.env
#   chmod 600 grokbot.env

# --- identity ---
BOT_NAME=Grok Bot
OWNER_NAME=John
LANGUAGE=en

# --- xAI / Grok ---
# Leave the key blank to stay on the local Qwen model. Never commit a real key.
XAI_API_KEY=xai-replace-me-not-a-real-key
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3
XAI_CHAT_MODEL=grok-4.3
XAI_VISION_MODEL=grok-4.3
XAI_STT_MODEL=grok-voice-transcribe-2.0
XAI_TTS_VOICE=eve

# auto: Grok for conversation when a key is set and budget remains, otherwise Ollama.
# Small talk uses the local model. Set OLLAMA_FALLBACK=1 to use Qwen if Grok cannot be reached.
LLM_BACKEND=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_FALLBACK=1
DAILY_TOKEN_BUDGET=200000
CONV_SHARE=0.20
VISION_SHARE=0.80

# --- speech ---
# local: faster-whisper for idle, wake, commands, and safety phrases.
# xai: send utterances to the cloud speech API instead.
STT_BACKEND=local
WHISPER_MODEL=base.en
WHISPER_THREADS=2
STOP_LISTENER=1
TTS_BACKEND=piper
PIPER_VOICE=/home/pi/grokbot/voices/en_US-lessac-medium.onnx

# Software wake is exactly "wake up wally". Do not add hello/hey/hi wally or a bare wally.
# WonderEcho firmware stays "Hello Hiwonder" until someone flashes it; this file does not.
TRIGGER=wonderecho
WAKE_WORDS=wake up wally
WAKE_ANYWHERE=gbot,grok
WAKE_PROMPT=Wake up Wally.
WAKE_ACK=Hello John, are you ready to rock and roll?
WAKE_PORT=auto
HW_WAKE=1
AUDIO_IN=gbmic
AUDIO_OUT=auto

# --- web UI on the Pi (port 8000) ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_HTTPS=0
WEB_TOKEN=replace-with-a-long-random-token

# --- motion ---
# Leave driving off until the gate, watchdog, and estop phrase are proven.
# ALLOW_AUTONOMY gates follow and pointed missions. Leave it off until acceptance.
ALLOW_MOTION=0
ALLOW_AUTONOMY=0
# Stock Hiwonder apps publish /controller/cmd_vel directly and skip the obstacle gate.
ALLOW_STOCK_DRIVE=0
AUTO_EXPLORE=0
# Camera-first wander is the default. Set to 1 only if you also want the Nav2 stack.
EXPLORE_NAV2=0
ROSBRIDGE_URL=ws://127.0.0.1:9090
ROS_CONTAINER=MentorPi
ROS_SHARED_HOST=/home/pi/docker/tmp
ROS_SHARED_CONTAINER=/home/ubuntu/shared

# --- battery (2S pack). Dry-run speaks and logs, and does not power the Pi off. ---
LOWV_WARN_V=6.8
LOWV_HARD_V=6.5
LOWV_SHUTDOWN_DELAY_S=60
LOWV_DRY_RUN=1

# Soft tip stop is 15 degrees. Hard latch stays 25. Do not put secrets in this file.
# The live key belongs in secrets.env, which systemd loads if present and git never tracks.
OBS_TILT_DEG=15
OBS_TILT_HARD_DEG=25
FOLLOW_RANGE_M=2
WALLY_LOAD_SHED=3.5
# Empty greeting and no spoken warm-up until you accept the install. HEALTH_SPEAK=1
# enables "LiDAR online" / depth lines. Leave them off for a silent sanity boot.
STARTUP_GREETING=
TTS_WARMUP=0
HEALTH_SPEAK=0
